<% body_id = locals[:body_id] %>
<div class="accordion-item">
  <h2 class="accordion-header" id="<%== locals[:id] %>">
    <button
      class="accordion-button collapsed"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#<%== body_id %>"
      aria-expanded="false"
      aria-controls="<%== body_id %>">
      <%== locals[:group] %>
    </button>
  </h2>
  <div
    id="<%== body_id %>"
    class="accordion-collapse collapse"
    aria-labelledby="<%== locals[:id] %>"
    data-bs-parent="#tournamentRolesAccordion">
    <div class="accordion-body">
      <% locals[:roles].each do |r| %>
        <%== erb :'admin/tournament_role',
          locals: { role: r[:role],
                    id: r[:id],
                    teams: r[:teams],
                    selected: r[:selected] } %>
      <% end %>
    </div>
  </div>
</div>
