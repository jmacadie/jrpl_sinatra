<div class="accordion-item">
  <h2 class="accordion-header" id="headingTwo">
    <button
      class="accordion-button collapsed"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#collapseTwo"
      aria-expanded="false"
      aria-controls="collapseTwo">
      Tournament Roles
    </button>
  </h2>
  <div
    id="collapseTwo"
    class="accordion-collapse collapse"
    aria-labelledby="headingTwo"
    data-bs-parent="#accordion">
    <div class="accordion-body">
      <div class="accordion" id="tournamentRolesAccordion">
        <% roles.each do |stage| %>
          <% stage_name = camelcase(stage[:stage], :lower) %>
          <% body_id = "#{stage_name}Body" %>
          <%== erb :'admin/tournament_role_group',
            locals: { id: stage_name,
                      body_id: body_id,
                      group: stage[:stage],
                      roles: stage[:group_roles] } %>
        <% end %>
      </div>
    </div>
  </div>
</div>
