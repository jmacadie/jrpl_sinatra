<form class="form-signup" role="form" method="post" action="/users/edit_credentials">
  <h2 class="form-login-heading">Administer your account</h2>
  <div id="logInMessage"></div>
  <label>Change username / e-mail:</label>
  <%== erb :'forms/form_field',
           locals: { id: 'user_name', value: @user[:user_name] } %>
  <%== erb :'forms/form_field',
           locals: { id: 'email', value: @user[:email] } %>
  <label>
    Change password:<br>
    <small>Leave blank to keep current</small>
  </label>
  <%== erb :'forms/password_field',
           locals: { id: 'pword', placeholder: 'New Password' } %>
  <%== erb :'forms/password_field',
           locals: { id: 'reenter_pword',
                     placeholder: 'Re-enter Password' } %>
  <hr>
  <label for="current_pword">Current password required for any changes:</label>
  <%== erb :'forms/password_field',
           locals: { id: 'current_pword',
                     placeholder: 'Current Password',
                     required: true } %>
  <%== erb :'forms/authenticity_token' %>
  <%== erb :'forms/submit_button', locals: { label: 'Change' } %>
</form>
<a href="/">Cancel</a>
