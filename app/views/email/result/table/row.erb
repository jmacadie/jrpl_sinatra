<% if shade %>
<tr style="background-color: #f4ecdc;">
<% else %>
<tr>
<% end %>
  <%== erb :'email/common/table_row_cell', locals: { align: 'left' } %>
    <%== user[:rank] %>
  </td>
  <%== erb :'email/common/table_row_cell', locals: { align: 'left' } %>
    <%== user[:user_name] %>
  </td>
  <%== erb :'email/common/table_row_cell', locals: { align: 'center' } %>
    <%== points_for_print(user[:result_points]) %>
  </td>
  <%== erb :'email/common/table_row_cell', locals: { align: 'center' } %>
    <%== points_for_print(user[:score_points]) %>
  </td>
  <%== erb :'email/common/table_row_cell', locals: { align: 'center' } %>
    <%== points_for_print(user[:result_points] + user[:score_points])  %>
  </td>
</tr>
