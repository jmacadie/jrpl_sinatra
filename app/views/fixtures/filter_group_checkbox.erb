<div class="form-check mb-2">
  <input
    class="form-check-input"
    type="checkbox"
    id="ckbGroup<%== group %>"
    name="gr_<%== group %>"
    <%== checked_if(checked) %>>
  <label class="form-check-label" for="ckbGroup<%== group %>">
    <strong>Group <%== group %></strong><br>
    <%== teams %>
  </label>
</div>
