          <h3 class="h5">Select Stages / Groups</h3>
          <%== erb :'fixtures/filter_groups' %>
          <% [
            ['ckbR32', 'st_r32', :round32, 'Round of 32'],
            ['ckbR16', 'st_r16', :round16, 'Round of 16'],
            ['ckbQuarterFinals', 'st_qf', :quarter_final, 'Quarter-finals'],
            ['ckbSemiFinals', 'st_sf', :semi_final, 'Semi-finals'],
            ['ckbFinal', 'st_f', :final, 'Final']
          ].each do |id, name, stage, label| %>
            <%== erb :'fixtures/filter_checkbox',
                     locals: { id: id,
                               name: name,
                               checked: session[:criteria][:stages][stage],
                               label: label } %>
          <% end %>
