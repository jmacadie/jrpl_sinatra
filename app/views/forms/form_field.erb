<% field_type = defined?(type) && type ? type : 'text' %>
<% field_name = defined?(name) && name ? name : id %>
<input type="<%== field_type %>"
       class="form-control"
       id="<%== id %>"
       name="<%== field_name %>"
       <% if defined?(placeholder) && placeholder %>
       placeholder="<%== placeholder %>"
       <% end %>
       <% if defined?(value) %>
       value="<%== value %>"
       <% end %>
       <%== 'required' if defined?(required) && required %><%== ' autofocus' if defined?(autofocus) && autofocus %>>
