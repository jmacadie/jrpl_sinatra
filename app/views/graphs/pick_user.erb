<div class="col-6 col-sm-3">
  <div class="form-check">
    <input class="form-check-input"
           type="checkbox"
           value="<%== locals[:user][:user_id] %>"
           id="user_<%== locals[:user][:user_id] %>"
           <%== checked_if(locals[:user][:user_id],
                            expected: locals[:current_user_id]) %>>
    <label class="form-check-label" for="user_<%== locals[:user][:user_id] %>">
      <%== locals[:user][:user_name] %>
    </label>
  </div>
</div>
