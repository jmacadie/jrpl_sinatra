<div class="col">
  <div class="form-check">
    <input class="form-check-input"
           type="checkbox"
           value="<%== user[:user_id] %>"
           id="user_<%== user[:user_id] %>"
           <%== checked_if(user[:user_id], expected: current_user_id) %>>
    <label class="form-check-label" for="user_<%== user[:user_id] %>">
      <%== user[:user_name] %>
    </label>
  </div>
</div>
