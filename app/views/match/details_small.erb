<%== erb :'match/small_team_score_row',
         locals: { flag: home_flag(match),
                   name: home_name(match),
                   score_id: 'homeTeamPointsXS',
                   score: home_score(match) } %>
<% if origin?(match) %>
<div class="row d-flex d-sm-none text-start mt-2">
  <div class="col-12">
    <%== erb :'match/origin_button',
             locals: { id: 'btnHomeOriginXS', target: 'homeOriginXS' } %>
  </div>
</div>
<%== erb :'match/origin_panel',
         locals: { row_class: 'row d-flex d-sm-none text-start mt-2',
                   panels: [
                     { column_class: 'col-12',
                       id: 'homeOriginXS',
                       origin: origin_details(origin, 'ht') }
                   ] } %>
<% end %>
<div class="row d-flex d-sm-none text-start">
  <div class="col-4 offset-4"><small>vs.</small></div>
</div>
<%== erb :'match/small_team_score_row',
         locals: { flag: away_flag(match),
                   name: away_name(match),
                   score_id: 'awayTeamPointsXS',
                   score: away_score(match) } %>
<% if origin?(match) %>
<div class="row d-flex d-sm-none text-start mt-2">
  <div class="col-12">
    <%== erb :'match/origin_button',
             locals: { id: 'btnAwayOriginXS', target: 'awayOriginXS' } %>
  </div>
</div>
<%== erb :'match/origin_panel',
         locals: { row_class: 'row d-flex d-sm-none text-start mt-2',
                   panels: [
                     { column_class: 'col-12',
                       id: 'awayOriginXS',
                       origin: origin_details(origin, 'at') }
                   ] } %>
<% end %>
