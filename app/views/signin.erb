<form class="form-login" role="form" method="post" action="/users/signin">
  <h2 class="form-login-heading">Please log in</h2>
  <div id="logInMessage"></div>
  <%== erb :'forms/form_field',
           locals: { id: 'login',
                     placeholder: 'Username / E-mail address',
                     required: true,
                     autofocus: true } %>
  <%== erb :'forms/password_field',
           locals: { id: 'pword',
                     placeholder: 'Password',
                     required: true } %>
  <%== erb :'forms/remember_me' %>
  <%== erb :'forms/authenticity_token' %>
  <%== erb :'forms/submit_button', locals: { label: 'Log in' } %>
</form>
