<form class="form-signup" role="form" method="post" action="/users/signup">
  <h2 class="form-login-heading">Create a new account</h2>
  <p>Provide a username (you will be referred to as this by the website) and an e-mail</p>
  <div id="logInMessage"></div>
  <%== erb :'forms/form_field',
           locals: { id: 'user_name',
                     placeholder: 'Username',
                     required: true,
                     autofocus: true } %>
  <%== erb :'forms/form_field',
           locals: { id: 'email',
                     placeholder: 'E-mail address',
                     required: true } %>
  <%== erb :'forms/password_field',
           locals: { id: 'pword',
                     placeholder: 'Password',
                     required: true } %>
  <%== erb :'forms/password_field',
           locals: { id: 'reenter_pword',
                     placeholder: 'Re-enter Password',
                     required: true } %>
  <%== erb :'forms/form_field',
           locals: { id: 'bot_check',
                     placeholder: 'Stop the bots: enter THE four letters',
                     required: true } %>
  <%== erb :'forms/remember_me' %>
  <%== erb :'forms/authenticity_token' %>
  <%== erb :'forms/submit_button', locals: { label: 'Sign Up' } %>
</form>
