<h1>Tables</h1>
<h2>Overall</h2>
<%== erb :'tables/table', locals: { table: tables[:overall_table] } %>
<div class="accordion" id="tablesAccordion">
  <div class="accordion-item">
    <h2 class="accordion-header" id="headingGroup">
      <button
        class="accordion-button collapsed"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#collapseGroup"
        aria-expanded="false"
        aria-controls="collapseGroup">
        Group Tables
      </button>
    </h2>
    <div
      id="collapseGroup"
      class="accordion-collapse collapse"
      aria-labelledby="headingGroup"
      data-bs-parent="#tablesAccordion">
      <div class="accordion-body">
        <%== erb :'tables/table',
                 locals: { table: tables[:group_table] } %>
      </div>
    </div>
  </div>
  <div class="accordion-item">
    <h2 class="accordion-header" id="headingKnockout">
      <button
        class="accordion-button collapsed"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#collapseKnockout"
        aria-expanded="false"
        aria-controls="collapseKnockout">
        Knockout Tables
      </button>
    </h2>
    <div
      id="collapseKnockout"
      class="accordion-collapse collapse"
      aria-labelledby="headingKnockout"
      data-bs-parent="#tablesAccordion">
      <div class="accordion-body">
        <%== erb :'tables/table',
                 locals: { table: tables[:knockout_table] } %>
      </div>
    </div>
  </div>
  <div class="accordion-item">
    <h2 class="accordion-header" id="headingToms">
      <button
        class="accordion-button collapsed"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#collapseToms"
        aria-expanded="false"
        aria-controls="collapseToms">
        Toms
      </button>
    </h2>
    <div
      id="collapseToms"
      class="accordion-collapse collapse"
      aria-labelledby="headingToms"
      data-bs-parent="#tablesAccordion">
      <div class="accordion-body">
        <%== erb :'tables/table',
                 locals: { table: tables[:tom_table] } %>
      </div>
    </div>
  </div>
  <div class="accordion-item">
    <h2 class="accordion-header" id="headingPecks">
      <button
        class="accordion-button collapsed"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#collapsePecks"
        aria-expanded="false"
        aria-controls="collapsePecks">
        Pecks
      </button>
    </h2>
    <div
      id="collapsePecks"
      class="accordion-collapse collapse"
      aria-labelledby="headingPecks"
      data-bs-parent="#tablesAccordion">
      <div class="accordion-body">
        <%== erb :'tables/table',
                 locals: { table: tables[:peck_table] } %>
      </div>
    </div>
  </div>
</div>
