<form class="form-tournament-role d-flex align-items-end gap-2 flex-wrap" method="post" action="/tournament_role">
  <div>
    <label class="form-label" for="tournamentRole<%== @role_camel %>"><%== @role %></label>
    <select class="form-select" name="team" id="tournamentRole<%== @role_camel %>">
      <option value="0"<%== " selected" if @selected == 0 %>>Not yet selected</option>
      <% @teams.filter{ |t| t[:team_id] > 0 }.each do |t| %>
      <option value="<%== t[:team_id] %>"<%== " selected" if t[:team_id] == @selected %>><%== t[:team] %></option>
      <% end %>
    </select>
  </div>
  <input type="hidden" name="role" value="<%== @id %>">
  <input type="hidden" name="authenticity_token" value="<%== Rack::Protection::AuthenticityToken.token(env['rack.session']) %>" />
  <button type="submit" class="btn btn-warning">Update</button>
</form>
