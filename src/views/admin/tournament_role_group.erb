<div class="accordion-item">
  <h2 class="accordion-header" id="<%== @id %>">
    <button
      class="accordion-button<%== ' collapsed' if !@expand_stage %>"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#<%== @body_id %>"
      aria-expanded="<%== @expand_stage %>"
      aria-controls="<%== @body_id %>">
      <%== @tournament_role_group %>
    </button>
  </h2>
  <div
    id="<%== @body_id %>"
    class="accordion-collapse collapse<%== ' show' if @expand_stage %>"
    aria-labelledby="<%== @id %>"
    data-bs-parent="#tournamentRolesAccordion">
    <div class="accordion-body">
      <% @roles.each do |r| %>
        <% @role = r[:role] %>
        <% @id = r[:id] %>
        <% @role_camel = camelcase(@role, :upper) %>
        <% @teams = r[:teams] %>
        <% @selected = r[:selected] %>
        <%== erb :'admin/tournament_role' %>
      <% end %>
    </div>
  </div>
</div>
