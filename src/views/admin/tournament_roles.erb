<div class="accordion-item">
  <h2 class="accordion-header" id="headingTwo">
    <button
      class="accordion-button<%== ' collapsed' if !@show %>"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#collapseTwo"
      aria-expanded="<%== @show %>"
      aria-controls="collapseTwo">
      Tournament Roles
    </button>
  </h2>
  <div
    id="collapseTwo"
    class="accordion-collapse collapse<%== ' show' if @show %>"
    aria-labelledby="headingTwo"
    data-bs-parent="#accordion">
    <div class="accordion-body">
      <div class="accordion" id="tournamentRolesAccordion">
        <% @roles.each do |tr| %>
          <% stage = camelcase(tr[:stage], :lower) %>
          <% @id = stage %>
          <% @body_id = "#{stage}Body" %>
          <% @tournament_role_group = tr[:stage] %>
          <% @roles = tr[:roles] %>
          <% @expand_stage = @roles.map{ |r| r[:id] }.include? @show %>
          <%== erb :'admin/tournament_role_group' %>
        <% end %>
      </div>
    </div>
  </div>
</div>
