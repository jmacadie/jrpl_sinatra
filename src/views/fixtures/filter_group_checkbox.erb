<div class="form-check mb-2">
  <input
    class="form-check-input"
    type="checkbox"
    id="ckbGroup<%== locals[:group] %>"
    name="gr_<%== locals[:group] %>"
    <%== checked_if(locals[:checked]) %>>
  <label class="form-check-label" for="ckbGroup<%== locals[:group] %>">
    <strong>Group <%== locals[:group] %></strong><br>
    <%== locals[:teams] %>
  </label>
</div>
