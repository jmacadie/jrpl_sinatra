          <h3 class="h5">Select Stages / Groups</h3>
          <%== erb :'fixtures/filter_groups' %>
          <div class="form-check mb-2">
            <input
              class="form-check-input"
              type="checkbox"
              id="ckbR32"
              name="st_r32"
