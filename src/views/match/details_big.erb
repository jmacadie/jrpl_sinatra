<!-- Layout for tablets and bigger -->
<div class="row hidden-xs">
  <div class="col-sm-2 text-center">
    <span class="<%== home_flag(@match) %>"></span>
  </div>
  <div class="col-sm-2 text-right">
    <span class="lead"><%== home_name(@match) %></span>
    <% if origin?(@match) %>
    <br />
    <button id="btnHomeOrigin" type="button" class="btn btn-info btn-xs" data-state="show">Show Origin</button>
    <% end %>
  </div>
  <div class="col-sm-1 text-center lead">
    <b><span id="homeTeamPoints"><%== home_score(@match) %></span></b>
  </div>
  <div class="col-sm-2 text-center">vs.</div>
  <div class="col-sm-1 text-center lead">
    <b><span id="awayTeamPoints"><%== away_score(@match) %></span></b>
  </div>
  <div class="col-sm-2 text-left lead">
    <span class="lead"><%== away_name(@match) %></span>
    <% if origin?(@match) %>
    <br />
    <button id="btnAwayOrigin" type="button" class="btn btn-info btn-xs" data-state="show">Show Origin</button>
    <% end %>
  </div>
  <div class="col-sm-2 text-center">
    <span class="<%== away_flag(@match) %>"></span>
  </div>
</div><!-- /row (match result) -->
<% if origin?(@match) %>
<!-- Team origin details for tablets and bigger -->
<div class="row hidden-xs text-left">
  <div class="col-sm-5">
    <div id="homeOrigin" class="panel panel-default panel-origin" style="display: none;">
      <div class="panel-body">
      <a href="../match/<%== @origin[:ht_match_id] %>">
      <div class="row text-center"><p>
        <div class="col-xs-12">
          <strong><%== @origin[:ht_stage] %></strong>
        </div>
      </p></div>
      <small>
        <div class="row"><p>
          <div class="col-xs-3 text-right"><span class="<%== flag_css(@origin[:ht_home_team_s], true) %>"></span></div>
          <div class="col-xs-6"><%== @origin[:ht_home_team] %></div>
          <div class="col-xs-3"><%== @origin[:ht_home_team_points] %></div>
        </p></div>
        <div class="row"><p>
          <div class="col-xs-3 text-right"><span class="<%== flag_css(@origin[:ht_away_team_s], true) %>"></span></div>
          <div class="col-xs-6"><%== @origin[:ht_away_team] %></div>
          <div class="col-xs-3"><%== @origin[:ht_away_team_points] %></div>
        </p></div>
      </small>
      </a>
      </div>
    </div>
  </div>
  <div class="col-sm-5 col-sm-offset-2">
    <div id="awayOrigin" class="panel panel-default panel-origin" style="display: none;">
      <div class="panel-body">
      <a href="../match/<%== @origin[:at_match_id] %>">
      <div class="row text-center"><p>
        <div class="col-xs-12">
          <strong><%== @origin[:at_stage] %></strong>
        </div>
      </p></div>
      <small>
        <div class="row"><p>
          <div class="col-xs-3 text-rigat"><span class="<%== flag_css(@origin[:at_home_team_s], true) %>"></span></div>
          <div class="col-xs-6"><%== @origin[:at_home_team] %></div>
          <div class="col-xs-3"><%== @origin[:at_home_team_points] %></div>
        </p></div>
        <div class="row"><p>
          <div class="col-xs-3 text-rigat"><span class="<%== flag_css(@origin[:at_away_team_s], true) %>"></span></div>
          <div class="col-xs-6"><%== @origin[:at_away_team] %></div>
          <div class="col-xs-3"><%== @origin[:at_away_team_points] %></div>
        </p></div>
      </small>
      </a>
      </div>
    </div>
  </div>
</div>
<% end %>
