<!-- Layout for phones -->
<div class="row visible-xs text-left small-match-row">
  <div class="small-match-row">
    <div class="col-xs-4">
      <span class="<%== home_flag(@match) %>"></span>
    </div>
    <div class="col-xs-4"><strong><%== home_name(@match) %></strong></div>
    <div class="col-xs-4" id="homeTeamPointsXS"><%== home_score(@match) %></div>
  </div>
</div>
<% if origin?(@match) %>
<div class="row visible-xs text-left">
  <div class="col-xs-2">
    <button id="btnHomeOriginXS" type="button" class="btn btn-info btn-xs" data-state="show">Show Origin</button>
  </div>
</div>
<div class="row visible-xs text-left">
  <div class="col-xs-12">
    <div id="homeOriginXS" class="panel panel-default panel-origin" style="display: none;">
      <div class="panel-body">
      <a href="../match/<%== @origin[:ht_match_id] %>">
      <div class="row text-center"><p>
        <div class="col-xs-12">
          <strong><%== @origin[:ht_stage] %></strong>
        </div>
      </p></div>
      <small>
        <div class="row"><p>
          <div class="col-xs-3 text-right"><span class="<%== flag_css(@origin[:ht_home_team_s], true) %>"></span></div>
          <div class="col-xs-6"><%== @origin[:ht_home_team] %></div>
          <div class="col-xs-3"><%== @origin[:ht_home_team_points] %></div>
        </p></div>
        <div class="row"><p>
          <div class="col-xs-3 text-right"><span class="<%== flag_css(@origin[:ht_away_team_s], true) %>"></span></div>
          <div class="col-xs-6"><%== @origin[:ht_away_team] %></div>
          <div class="col-xs-3"><%== @origin[:ht_away_team_points] %></div>
        </p></div>
      </small>
      </a>
      </div>
    </div>
  </div>
</div>
<% end %>
<div class="row visible-xs text-left">
  <div class="col-xs-4 col-xs-offset-4"><small>vs.</small></div>
</div>
<div class="row visible-xs text-left">
  <div class="small-match-row">
    <div class="col-xs-4">
      <span class="<%== away_flag(@match) %>"></span>
    </div>
    <div class="col-xs-4"><strong><%== away_name(@match) %></strong></div>
    <div class="col-xs-4" id="awayTeamPointsXS"><%== away_score(@match) %></div>
  </div>
</div>
<% if origin?(@match) %>
<div class="row visible-xs text-left">
  <div class="col-xs-2">
    <button id="btnAwayOriginXS" type="button" class="btn btn-info btn-xs" data-state="show">Show Origin</button>
  </div>
</div>
<div class="row visible-xs text-left">
  <div class="col-xs-12">
    <div id="awayOriginXS" class="panel panel-default panel-origin" style="display: none;">
      <div class="panel-body">
      <a href="../match/<%== @origin[:at_match_id] %>">
      <div class="row text-center"><p>
        <div class="col-xs-12">
          <strong><%== @origin[:at_stage] %></strong>
        </div>
      </p></div>
      <small>
        <div class="row"><p>
          <div class="col-xs-3 text-rigat"><span class="<%== flag_css(@origin[:at_home_team_s], true) %>"></span></div>
          <div class="col-xs-6"><%== @origin[:at_home_team] %></div>
          <div class="col-xs-3"><%== @origin[:at_home_team_points] %></div>
        </p></div>
        <div class="row"><p>
          <div class="col-xs-3 text-rigat"><span class="<%== flag_css(@origin[:at_away_team_s], true) %>"></span></div>
          <div class="col-xs-6"><%== @origin[:at_away_team] %></div>
          <div class="col-xs-3"><%== @origin[:at_away_team_points] %></div>
        </div>
      </small>
      </a>
      </div>
    </div>
  </div>
<% end %>
</div>
