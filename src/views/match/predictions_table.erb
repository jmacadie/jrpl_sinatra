<h5>Table</h5>
<table class="table table-striped">
  <thead>
    <tr>
      <th>Player</th>
      <th>Prediction</th>
      <th>Points</th>
    </tr>
  </thead>
  <tbody>
    <% @predictions.each do |prediction| %>
      <%== erb :'match/predictions_table_row',
               locals: { prediction: prediction } %>
    <% end %>
  </tbody>
</table>
